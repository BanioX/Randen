{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["vite/client", "node"],
    // vite.config.ts imports scripts/*.ts with extension (Node-native TypeScript, Vite's native loader).
    "allowImportingTsExtensions": true
  },
  "include": ["src", "e2e", "vite.config.ts", "vitest.config.ts", "playwright.config.ts", "scripts"]
}
