// Cloudflare Workers Builds: a Preview URL for every branch and pull request, production from
// `main`. Static assets only, no server code: the app keeps all data in the browser (ADR-0006).
// Setup steps for the dashboard: docs/previews.md.
{
  "name": "randen",
  "compatibility_date": "2026-10-23",
  "assets": {
    // Built by `pnpm build:cf`.
    "directory": "./apps/web/dist",
    // Unknown paths serve index.html, so the router handles /stock and the like.
    "not_found_handling": "single-page-application",
  },
  "workers_dev": true,
  "preview_urls": true,
  // Required for Worker Previews; empty because the app has no bindings, variables or secrets.
  "previews": {},
}
